{
  "name": "agent-smith-browser",
  "version": "0.2.0",
  "description": "Agent Smith Browser (ASB) — attach to the user's own Chrome or Edge on their computer (CDP) and drive that session. A11y refs, MCP + CLI. Managed Chromium is the example.com demo. Advisory canvas hints.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hantiiii/agent-smith-browser.git"
  },
  "bin": {
    "agent-browser": "./bin/agent-browser.js",
    "asb": "./bin/agent-browser.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "mcp": "node dist/mcp/server.js",
    "cli": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright": "^1.49.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ]
}
